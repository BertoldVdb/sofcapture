// sofd configuration (HuJSON: comments and trailing commas allowed).
// Install as /etc/sofd/sofd.hujson. All sections are optional.
{
  // Leave out to run without a broker.
  "mqtt": {
    "host": "localhost",
    "port": 1883,
    // "prefix": "sofd/myhost",          // default "sofd/<hostname>"
    // "username": "sofd",
    // "password_file": "/etc/sofd/mqtt.pass",
  },

  "sampler": {
    "default_rate_hz": 50,             // also the chrony sample rate
    // "model_hz": 1,                    // how often controllers/<id>/model is published
    // "rt_prio": 50,
    // "cpu": 2,
    // Tighter samples at the cost of power (on our test PC it took both):
    // "max_cpu_latency_us": 200,
    // "cpu_governor": "performance",
  },

  // Per USB controller, by sofd's id. counter_lead_ns: README "Frame counter lead"
  "controllers": {
    // "0000:01:00.0": { "counter_lead_ns": 125700 },
  },

  "gnss": {
    "attach": "all",                     // or "none", or ["003000343645501720393657"]
    "defaults": {
      "baud": 38400,
      "initial_baud": 9600,              // receiver's power-on baud, e.g. 38400 for u-blox M10/F9
      // "chrony": "/run/chrony.sofgnss.sock",       // use {serial} for one socket per board
      // "firmware": "/var/lib/sofd/sofgnss.bin",
      // "fix": false,                   // no gnss/<serial>/fix message per epoch
      // "serial_delay_ns": 38000000,    // receivers and USB modules without pulses: rough time from their output (README)
      // "leap_seconds": 18,             // GPS minus UTC until the receiver knows it (up to 12.5 min after a cold start)
      // "constellations": ["gps", "galileo", "beidou"],   // u-blox 9 and later
    },
    "boards": {
      // "003000343645501720393657": { "sof_delay_ns": 1300 },
    },
    // Receivers on a serial port with their PPS on /dev/pps, no board (README)
    "receivers": {
      // "ttyS0": { "tty": "/dev/ttyS0", "pps": "/dev/pps0", "chrony": "/run/chrony.ttyS0.sock" },
      // "pps_gpio": 18 instead of "pps": sofd polls the Raspberry Pi GPIO itself (±0.2 us)
      // Options of a USB module (no tty), here its own serial_delay_ns
      // "usb-1-1.3": { "serial_delay_ns": 45000000 },
    },
    // u-blox modules on their own USB port, no pulses: "all", "none" or a list of names (README)
    // "usb_receivers": "all",
    // MQTT clients allowed to act as GNSS reference (see MQTT-GUIDE.md)
    "external": {
      // "myapp": { "chrony": "/run/chrony.myapp.sock", "sof_delay_ns": 0 },
      // "*": {},                         // any other client
    },
  },
}
