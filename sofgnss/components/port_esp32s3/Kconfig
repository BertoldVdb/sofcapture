menu "sofgnss board (ESP32-S3)"

    comment "Defaults suit the Seeed Studio XIAO ESP32-S3"

    config SOFGNSS_PPS_GPIO
        int "PPS input GPIO"
        default 7
        help
            XIAO pin D8 (GPIO7), next to the RX pin.

    config SOFGNSS_PPS_RISING_EDGE
        bool "Capture PPS on the rising edge"
        default y

    config SOFGNSS_PPS_PULLDOWN
        bool "Enable internal pull-down on the PPS input"
        default n

    config SOFGNSS_GPS_UART_NUM
        int "UART peripheral for the GPS"
        range 1 2
        default 1

    config SOFGNSS_GPS_TX_GPIO
        int "GPS UART TX GPIO (to the receiver's RX)"
        default 43
        help
            XIAO pin D6, labelled TX.

    config SOFGNSS_GPS_RX_GPIO
        int "GPS UART RX GPIO (from the receiver's TX)"
        default 44
        help
            XIAO pin D7, labelled RX.

    config SOFGNSS_GPS_DEFAULT_BAUD
        int "GPS UART baud rate until the host sets one"
        default 38400

    config SOFGNSS_TICK_HZ
        int "Timestamp counter frequency (Hz)"
        default 80000000
        help
            MCPWM capture timer resolution. 80 MHz is the maximum on the ESP32-S3.

    config SOFGNSS_CAL_GPIO
        int "Calibration signal output GPIO"
        default 4
        help
            XIAO pin D3. Calibration bursts for an SDR. Connect through a series
            resistor, DC block and attenuators.

    config SOFGNSS_CAL_CS_GPIO
        int "Calibration burst-start loopback GPIO"
        default 5
        help
            XIAO pin D4. Used internally to timestamp each burst; needs no
            wiring. Low during a burst, so it works as a scope trigger.

    config SOFGNSS_LED_GPIO
        int "Status LED GPIO (-1 for none)"
        default 21
        help
            Shows PPS and GPS serial state (see README). The XIAO ESP32-S3 user
            LED is GPIO21, active low.

    config SOFGNSS_LED_ACTIVE_LOW
        bool "Status LED is active low"
        default y

    config SOFGNSS_USB_VID
        hex "USB vendor ID"
        default 0x20A0

    config SOFGNSS_USB_PID
        hex "USB product ID"
        default 0x4288

endmenu
